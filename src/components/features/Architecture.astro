---
import CodeTerminal from '@/components/ui/CodeTerminal.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
---

<section>
  <SectionHeading
    label="Architecture"
    title="Simple by design"
    description="One binary, one extraction engine. There is no service to host — drive it from the command line, embed the Go library, or run it as an MCP server."
  />

  <CodeTerminal
    tabs={[
      {
        label: 'CLI',
        method: 'cli',
        code: '# Markdown (default), JSON, or an accessibility tree\nseaportal https://example.com\nseaportal --json https://example.com\nseaportal --snapshot https://example.com',
      },
      {
        label: 'Go library',
        method: 'go',
        code: 'import "github.com/pinchtab/seaportal"\n\nresult := seaportal.FromURL("https://example.com")\nfmt.Println(result.Content) // extracted Markdown',
      },
      {
        label: 'MCP',
        method: 'mcp',
        code: '# Run as an MCP server over stdio\nseaportal mcp',
      },
    ]}
    defaultTab="cli"
    terminalLabel="seaportal"
  />
</section>
