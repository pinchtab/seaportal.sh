---
import SectionHeading from '@/components/ui/SectionHeading.astro';

const bars = [
  { count: '~10,000', label: 'Raw HTML', height: '100%', highlight: false },
  { count: '~3,000', label: 'Basic extraction', height: '30%', highlight: false },
  { count: '~1,500', label: 'SeaPortal extract', height: '15%', highlight: true },
  { count: '~500', label: 'SeaPortal summary', height: '5%', highlight: true },
];
---

<section>
  <SectionHeading
    label="Token Efficiency"
    title="Less tokens, same content"
    description="SeaPortal strips the noise and delivers only what matters. Summarization compresses further for maximum token efficiency."
  />

  <div class="grid h-55 grid-cols-4 items-end gap-4 py-4 pb-16 sm:gap-5">
    {
      bars.map((bar) => (
        <div class="flex h-full flex-col items-center justify-end gap-2">
          <span class="font-mono text-xs font-semibold text-brand-text">{bar.count}</span>
          <div
            class:list={[
              'w-full max-w-23.75 rounded-t-md',
              bar.highlight
                ? 'bg-linear-to-b from-brand-accent to-brand-accent-dark shadow-[0_0_20px_rgba(34,211,238,0.2)]'
                : 'bg-[rgba(15,50,72,0.3)]',
            ]}
            style={`height: ${bar.height};`}
          ></div>
          <span class="text-center font-mono text-[0.65rem] leading-4 text-brand-text-dim">
            {bar.label}
          </span>
        </div>
      ))
    }
  </div>
</section>
