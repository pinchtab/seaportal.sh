---
import Button from '@/components/ui/Button.astro';
import Pill from '@/components/ui/Pill.astro';
import { cn } from '@/lib/utils';

const featurePills = ['Go', 'No browser', 'MCP server', 'MIT licensed'];
---

<section
  class={cn(
    'relative isolate flex items-center justify-center',
    'pt-20 pb-15 px-6 sm:px-8 overflow-hidden'
  )}
>
  <!-- Hero top radial glow -->
  <div
    class={cn(
      'pointer-events-none absolute left-1/2 z-0',
      'h-215 w-215 -translate-x-1/2 rounded-full'
    )}
    style="top: -300px; background: radial-gradient(circle, rgba(34, 211, 238, 0.12) 0%, rgba(34, 211, 238, 0.05) 42%, transparent 72%);"
    aria-hidden="true"
  />

  <!-- Content -->
  <div class="relative z-10 max-w-4xl mx-auto pt-12 text-center">
    <!-- Banner image -->
    <div class="relative z-10 mb-10 flex justify-center">
      <img
        src="/og-image.jpg"
        alt="SeaPortal — fast content extraction for AI agents"
        width="1280"
        height="720"
        loading="eager"
        fetchpriority="high"
        class="w-full max-w-3xl rounded-2xl border border-brand-border shadow-glow"
      />
    </div>

    <!-- Brand name -->
    <h1
      class={cn(
        'relative z-20',
        'font-bold leading-[1.1] tracking-[-0.03em]',
        'text-[clamp(2.8rem,6vw,4.2rem)]',
        'mb-2'
      )}
    >
      <span class="gradient-text inline-block">
        SeaPortal
      </span>
    </h1>

    <!-- Tagline -->
    <div
      class={cn('mb-5 text-base font-medium uppercase tracking-[0.15em] text-brand-accent')}
    >
      Fast content extraction for AI agents
    </div>

    <!-- Description -->
    <p class={cn(
      'text-[1.15rem] text-brand-text-muted leading-[1.7]',
      'max-w-130 mx-auto mb-8'
    )}>
      Turn static and server-rendered pages into clean Markdown or a semantic accessibility tree your agent can act on. HTTP-first and browserless — fast on the pages that allow it, and it tells you when one actually needs a browser. Use it as a CLI, a Go library, or an MCP server.
    </p>

    <!-- Feature pills -->
    <div class="mb-9 flex flex-wrap items-center justify-center gap-2.5">
      {
        featurePills.map((pill) => (
          <Pill>{pill}</Pill>
        ))
      }
    </div>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5">
      <Button
        href="https://github.com/pinchtab/seaportal"
        variant="primary"
        size="md"
        class={cn(
          'w-full sm:w-auto h-12 px-7 rounded-[10px]',
          'shadow-[0_8px_18px_rgba(34,211,238,0.22)]',
          'hover:-translate-y-px hover:shadow-[0_12px_24px_rgba(34,211,238,0.28)]',
          'active:translate-y-0 text-[0.9rem]'
        )}
      >
        View on GitHub
      </Button>
      <Button
        href="/docs"
        variant="secondary"
        size="md"
        class={cn(
          'w-full sm:w-auto h-12 px-7 rounded-[10px]',
          'shadow-[inset_0_1px_0_rgb(255_255_255/0.03)]',
          'hover:bg-[rgba(255,255,255,0.08)] hover:border-[rgba(15,50,72,0.8)] hover:-translate-y-px',
          'text-[0.9rem]'
        )}
      >
        Docs
      </Button>
    </div>

    <!-- Fastest path to value: install + run in one line -->
    <div class="mt-6 flex justify-center">
      <code
        class={cn(
          'inline-block max-w-full overflow-x-auto whitespace-nowrap',
          'rounded-lg border border-brand-border bg-brand-surface',
          'px-4 py-2.5 font-mono text-[0.82rem] text-brand-text-muted'
        )}
      >
        <span class="select-none text-brand-text-dim">$ </span>npm install -g seaportal &amp;&amp; seaportal https://example.com
      </code>
    </div>

    <!-- Honest boundary, stated up front -->
    <p class="mx-auto mt-5 max-w-130 text-sm leading-6 text-brand-text-dim">
      It does not execute JavaScript, render pages, or manage sessions — by design. When a page needs any of that, SeaPortal tells you instead of guessing.
    </p>
  </div>
</section>
