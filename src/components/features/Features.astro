---
import SectionHeading from '@/components/ui/SectionHeading.astro';

const features = [
  {
    icon: '🧹',
    title: 'Clean extraction',
    description: 'Readable Markdown with nav, ads, and chrome removed — plus block and simhash near-duplicate dedupe.',
  },
  {
    icon: '🕸️',
    title: 'Selector-free scraping',
    description: 'Point it at any URL and get clean, structured output — no CSS selectors or brittle scraper scripts to write or maintain.',
  },
  {
    icon: '🌳',
    title: 'Accessibility snapshot',
    description: 'A semantic tree of the page where every node has a role, ref, and selector. Filter to interactive elements only.',
  },
  {
    icon: '⚡',
    title: 'HTTP-first, no browser',
    description: 'No headless overhead. On reachable static / SSR pages, extraction is typically p50 ~1s (50-site in-niche sweep — see Reliability).',
  },
  {
    icon: '🧭',
    title: 'Knows its limits',
    description: 'A fail-over triage, not a universal fetcher: it emits a browser-recommendation signal so you can route hard pages elsewhere.',
  },
  {
    icon: '🗺️',
    title: 'Sitemaps & feeds',
    description: 'Flatten sitemap.xml (recurses indexes, auto-decompresses .gz) and parse RSS, Atom, and JSON Feed.',
  },
  {
    icon: '🔌',
    title: 'MCP server',
    description: 'Run seaportal mcp to expose fetch_url, fetch_snapshot, parse_sitemap, and parse_feed as agent tools over stdio.',
  },
  {
    icon: '🛡️',
    title: 'Safe by default',
    description: 'SSRF / private-IP blocking, http(s)-only, and redirect and response-body caps applied out of the box.',
  },
  {
    icon: '📦',
    title: 'CLI · library · MCP',
    description: 'One Go binary, or import github.com/pinchtab/seaportal and call FromURL directly. Same engine everywhere.',
  },
];

// Secondary capabilities — layered on top of the core fetch-and-extract primitive.
const advanced = [
  'BM25 relevance scoring (--query / --top-n)',
  'Token-capped output (--max-tokens)',
  'Structural chunking',
  'Split output',
  'TEI-Lite export',
  'seabench eval harness',
];
---

<section id="features">
  <SectionHeading
    label="What It Does"
    title="Built for agents, not browsers"
    description="Fast, structured extraction you can drop straight into an agent loop."
  />

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((feature) => (
        <article class="rounded-2xl border border-brand-border-subtle bg-brand-surface p-6 transition-colors duration-200 hover:border-[rgba(34,211,238,0.4)] hover:bg-brand-surface-hover">
          <div class="mb-3 flex h-11 w-11 items-center justify-center rounded-xl bg-brand-accent/8 text-2xl leading-none" aria-hidden="true">
            {feature.icon}
          </div>
          <h3 class="mb-2 text-base font-semibold text-brand-text">{feature.title}</h3>
          <p class="text-sm leading-6 text-brand-text-muted">{feature.description}</p>
        </article>
      ))
    }
  </div>

  <p class="mt-4 text-sm leading-6 text-brand-text-dim">
    Latency figures come from committed live sweeps — a 50-site in-niche sample and the Tranco top-1000. See the
    <a href="/docs/reliability" class="text-brand-accent underline-offset-2 hover:underline">Reliability snapshot</a>
    for the full p50 / p90 / p95 breakdown and method.
  </p>

  <div class="mt-8 rounded-2xl border border-brand-border-subtle bg-brand-surface p-6">
    <h3 class="mb-1 text-base font-semibold text-brand-text">Advanced, when you need it</h3>
    <p class="mb-4 text-sm leading-6 text-brand-text-muted">
      The core stays a fast, no-browser fetch-and-extract primitive. These build on top of it — reach for them only when a pipeline calls for it.
    </p>
    <ul class="flex flex-wrap gap-2">
      {
        advanced.map((item) => (
          <li class="rounded-md border border-brand-border-subtle bg-brand-surface-code px-2.5 py-1 font-mono text-xs text-brand-text-muted">
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>
