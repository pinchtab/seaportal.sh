---
import CodeTerminal from '@/components/ui/CodeTerminal.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
---

<section id="quickstart">
  <SectionHeading
    label="Quick Start"
    title="Up and running in seconds"
    description="Install the binary, point it at a URL, get clean content back. No server to host, no browser to drive."
  />

  <CodeTerminal
    tabs={[
      {
        label: 'npm',
        method: 'npm',
        code: '# Install via npm\nnpm install -g seaportal',
      },
      {
        label: 'Go',
        method: 'go',
        code: '# Install via Go\ngo install github.com/pinchtab/seaportal/cmd/seaportal@latest',
      },
      {
        label: 'Run',
        method: 'run',
        code: [
          '# Extract a page as Markdown',
          'seaportal https://example.com',
          '',
          '# ---',
          '# title: "Example Domain"',
          '# url: https://example.com',
          '# confidence: 92',
          '# isSpa: false',
          '# pageClass: static',
          '# needsBrowser: false',
          '# ---',
          '#',
          '# # Example Domain',
          '# This domain is for use in illustrative examples...',
        ].join('\n'),
      },
      {
        label: 'JSON',
        method: 'json',
        code: [
          '# Same fetch, machine-readable — branch on the profile',
          'seaportal --json https://example.com',
          '',
          '# {',
          '#   "title": "Example Domain",',
          '#   "confidence": 92,',
          '#   "isSpa": false,',
          '#   "pageClass": "static",',
          '#   "profile": { "decision": "static-ok", "browserRecommended": false }',
          '# }',
        ].join('\n'),
      },
    ]}
    defaultTab="npm"
  />
</section>
