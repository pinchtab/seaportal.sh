---
import Footer from './Footer.astro';
import '@/styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  class?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title = 'SeaPortal — Fast content extraction for AI agents',
  description = 'SeaPortal turns static and server-rendered pages into clean Markdown or a semantic accessibility tree for AI agents. HTTP-first, no browser required. CLI, Go library, and MCP server.',
  class: pageClass,
  canonical,
  ogImage = '/og-image.png',
  ogType = 'website',
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : Astro.url.origin;
const canonicalUrl = canonical ? new URL(canonical, siteUrl).toString() : new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'SeaPortal',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, Windows',
  description: 'Fast, HTTP-first content extraction for AI agents. Turns static and server-rendered pages into clean Markdown or a semantic accessibility tree. CLI, Go library, and MCP server.',
  url: siteUrl,
  downloadUrl: 'https://github.com/pinchtab/seaportal',
  softwareVersion: 'latest',
  license: 'https://opensource.org/licenses/MIT',
  author: {
    '@type': 'Person',
    name: 'Luigi Agosti',
    url: 'https://github.com/luigi-agosti',
  },
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Luigi Agosti" />
    <meta
      name="keywords"
      content="content extraction, web scraping, AI agents, accessibility tree, snapshot, Markdown, MCP server, CLI, Go, HTTP-first, no browser, sitemap, RSS"
    />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="SeaPortal" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#22d3ee" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <title>{title}</title>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6Q265B4QBB"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-6Q265B4QBB');
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <main class={`flex-1 ${pageClass || ''}`}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
